# Copy to .env.local (gitignored). Store builds get the hosted values from eas.json.
#
# Local Supabase (`pnpm db:start`; keys from `supabase status`).
# Android emulator: use http://10.0.2.2:56321 instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In (Google Cloud OAuth clients). Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
