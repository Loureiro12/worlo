{
  "name": "worlo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @worlo/mobile start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:affected": "turbo run test typecheck --affected",
    "check": "pnpm lint && turbo run typecheck test",
    "e2e": "pnpm --filter @worlo/mobile e2e",
    "e2e:smoke": "pnpm --filter @worlo/mobile e2e:smoke",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "db:generate": "pnpm --filter @worlo/db generate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
